{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://org.local/mailbox/task.schema.json",
  "title": "Шина задач — task.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "from",
    "to",
    "status",
    "createdAt",
    "updatedAt",
    "statusHistory",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["slot-transfer", "review", "handoff"]
    },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "failed",
        "canceled",
        "rejected"
      ]
    },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "statusHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "status"],
        "properties": {
          "at": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "uri"],
        "properties": {
          "name": { "type": "string" },
          "uri": { "type": "string" },
          "mediaType": { "type": "string" }
        }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "theirs": { "type": "string" },
        "ours": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "slot", "dev_dt"] },
        "reset": { "type": "boolean" },
        "refs": { "type": "array" }
      }
    }
  },
  "if": {
    "properties": { "kind": { "const": "slot-transfer" } }
  },
  "then": {
    "required": ["git"],
    "properties": {
      "git": {
        "type": "object",
        "required": ["theirs"]
      }
    }
  }
}
