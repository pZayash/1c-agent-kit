// ponytail: одноразовая миграция opt-in БСП tools после rename data_history_* → bsp_versioning_*
// Запуск: конфигуратор / сеанс с правами на регистр mcp_ДоступностьИнструментов

СоответствиеИмен = Новый Соответствие;
СоответствиеИмен.Вставить("data_history_get", "bsp_versioning_list_get");
СоответствиеИмен.Вставить("data_history_version_get", "bsp_versioning_snapshot_get");
СоответствиеИмен.Вставить("data_history_diff_get", "bsp_versioning_diff_get");
СоответствиеИмен.Вставить("data_history_restore_post", "bsp_versioning_restore_post");

Перенесено = 0;
Для Каждого Пара Из СоответствиеИмен Цикл
	СтароеИмя = Пара.Ключ;
	НовоеИмя = Пара.Значение;
	Если mcp_НастройкиИнструментов.ИнструментДоступен(СтароеИмя)
		Или mcp_НастройкиИнструментов.ИнструментДоступен(НовоеИмя) Тогда
		mcp_НастройкиИнструментов.УстановитьДоступностьИнструмента(НовоеИмя, Истина);
		// data_history_diff_get переиспользовано платформенным tool — opt-in не снимаем
		Если СтароеИмя <> "data_history_diff_get" Тогда
			mcp_НастройкиИнструментов.УстановитьДоступностьИнструмента(СтароеИмя, Ложь);
		КонецЕсли;
		Перенесено = Перенесено + 1;
		Сообщить(СтрШаблон("MCP migrate: %1 → %2", СтароеИмя, НовоеИмя));
	КонецЕсли;
КонецЦикла;

Сообщить(СтрШаблон("MCP migrate BSP versioning: перенесено %1 из %2", Перенесено, СоответствиеИмен.Количество()));
