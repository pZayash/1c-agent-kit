{
  "version": 3,
  "comment": "Declarative layout of the kit harness into a consumer (idea: teamai ResourceHandler table). Engine: tools/kit-layout/kit_layout.py. Paths are consumer-relative; 'harness/' prefix = inside the kit submodule (HARNESS_REL). Resources with 'stacks' are effective only when the consumer selected that stack in .kit.json; absent = core. gitignore=true regenerates the kit-managed .gitignore block; fallback_manifest records hardlink/copy fallbacks for tombstones + drift checks. local_manifest files live in .kit/ (consumer-owned, tracked); legacy tools/cc-1c-skills-sync/local-*.txt are read as fallback.",
  "gitignore": true,
  "fallback_manifest": ".kit/fallback.txt",
  "resources": [
    {
      "id": "cursor-skills",
      "kind": "child-dirs",
      "source": "harness/core/cursor/skills",
      "target": ".cursor/skills",
      "local_manifest": ".kit/local-overlay.txt"
    },
    {
      "id": "cursor-rules",
      "kind": "child-files",
      "source": "harness/core/cursor/rules",
      "target": ".cursor/rules",
      "local_manifest": ".kit/local-overlay.txt"
    },
    {
      "id": "cursor-commands",
      "kind": "child-files",
      "source": "harness/core/cursor/commands",
      "target": ".cursor/commands",
      "local_manifest": ".kit/local-overlay.txt"
    },
    {
      "id": "core-tools",
      "kind": "child-dirs",
      "source": "harness/core/tools",
      "target": "tools",
      "include": [
        "sandbox",
        "docs-links"
      ],
      "local_manifest": ".kit/local-tools.txt"
    },
    {
      "id": "kit-tools-files",
      "kind": "child-files",
      "source": "harness/core/tools",
      "target": "tools",
      "include": [
        "git-partial-stage.py"
      ],
      "local_manifest": ".kit/local-tools.txt"
    },
    {
      "id": "cc-1c-skills",
      "kind": "child-dirs",
      "source": "harness/stacks/1c/skills",
      "target": ".cursor/skills",
      "local_manifest": ".kit/local-skills.txt",
      "stacks": [
        "1c"
      ]
    },
    {
      "id": "overlay-skills-1c",
      "kind": "child-dirs",
      "source": "harness/stacks/1c/cursor/skills",
      "target": ".cursor/skills",
      "local_manifest": ".kit/local-overlay.txt",
      "stacks": [
        "1c"
      ]
    },
    {
      "id": "overlay-rules-1c",
      "kind": "child-files",
      "source": "harness/stacks/1c/cursor/rules",
      "target": ".cursor/rules",
      "local_manifest": ".kit/local-overlay.txt",
      "stacks": [
        "1c"
      ]
    },
    {
      "id": "overlay-commands-1c",
      "kind": "child-files",
      "source": "harness/stacks/1c/cursor/commands",
      "target": ".cursor/commands",
      "local_manifest": ".kit/local-overlay.txt",
      "stacks": [
        "1c"
      ]
    },
    {
      "id": "kit-tools-1c",
      "kind": "child-dirs",
      "source": "harness/stacks/1c/tools",
      "target": "tools",
      "include": [
        "bsl-check",
        "load-changed-files",
        "mcp-call",
        "answer42",
        "rights-xml-lint"
      ],
      "local_manifest": ".kit/local-tools.txt",
      "stacks": [
        "1c"
      ]
    },
    {
      "id": "agents-skills",
      "kind": "alias",
      "source": ".cursor/skills",
      "target": ".agents/skills"
    },
    {
      "id": "claude-skills",
      "kind": "alias",
      "source": ".cursor/skills",
      "target": ".claude/skills"
    },
    {
      "id": "claude-commands",
      "kind": "alias",
      "source": ".cursor/commands",
      "target": ".claude/commands"
    },
    {
      "id": "pi-skills",
      "kind": "alias",
      "source": ".cursor/skills",
      "target": ".pi/skills"
    },
    {
      "id": "pi-prompts",
      "kind": "alias",
      "source": ".cursor/commands",
      "target": ".pi/prompts"
    },
    {
      "id": "pi-extensions",
      "kind": "alias",
      "source": "harness/pi/extensions",
      "target": ".pi/extensions"
    },
    {
      "id": "kilo-plugin",
      "kind": "alias",
      "source": "harness/kilo/plugin",
      "target": ".kilo/plugin"
    },
    {
      "id": "opencode-plugin",
      "kind": "alias",
      "source": "harness/kilo/plugin",
      "target": ".opencode/plugin"
    }
  ]
}
