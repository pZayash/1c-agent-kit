# Шаблон .env для потребителя kit (фрагмент)
# Скопируйте нужные ключи в свой .env.example / .env
# Секреты — только в локальном .env (не коммитить)

# Префикс новых объектов (пример: яя_, acme_)
PROJECT_PREFIX="{prefix}_"

# Платформа 1С — номера сборки только здесь
PLATFORM_VERSION="8.5.1"
PLATFORM_BUILD="8.5.1.1302"
COMPATIBILITY_MODE="8.5.1"

DESIGNER_PATH="C:/Program Files/1cv8/8.5.1.1302/bin/1cv8.exe"
IB_CONNECTION="/F C:/path/to/dev-database"

# Пути исходников (compat: conf/ + cfe.xml/)
CONFIG_PATH="conf"
EXTENSIONS_PATH="cfe.xml"

# designer | ibcmd
LOAD_ENGINE="designer"

# Preflight линтера XML метаданных перед импортом (объект «не в формате дампа»
# роняет LoadConfigFromFiles/ibcmd import нативно — mdmp/вис).
# true (по умолчанию) — XML дельты conf/ + каталоги изменённых расширений,
# список файлом (--list-file); стоп только на коде линтера 1 ([ERROR]);
# коды 2/3/4 и отсутствие линтера/python — WARN и загрузка продолжается.
# Обход (только осознанно): --no-xml-lint или XML_LINT="false".
# XML_LINT="true"
# Свой путь к check.py (пусто = <корень>/tools/metadata-xml-lint/check.py)
# METADATA_LINT_PY=""



# Apache для -U на файловой ИБ (опционально)
# APACHE_SERVICE_NAME="Apache2.4"

# Отладочный узел: автономный сервер 1С (ibsrv) на КОПИИ файловой базы.
# Скилл /db-server: yaml | start | stop | status | basic.
# IBSRV_PATH="C:/Program Files/1cv8/8.5.1.1302/bin/ibsrv.exe"
# IBSRV_DB_PATH="C:/path/to/debug-database-copy"
# IBSRV_NAME="dev.debug"
# IBSRV_DATA="C:/path/to/ibsrv-data"          # вне репозитория
# IBSRV_CONFIG=""                               # пусто = .tmp/ibsrv/server.yaml
# IBSRV_HTTP_ADDRESS="localhost"
# IBSRV_HTTP_PORT="8315"                        # не конфликтовать с Apache
# IBSRV_HTTP_BASE="/"
# IBSRV_DIRECT_REGPORT="1542"                   # конфигуратор: /S host:port\name
# IBSRV_DEBUG="http"                            # none|tcp|http|server
# IBSRV_DEBUG_PORT="1551"
# IBSRV_SERVICES="mcp,mcp-dev"                  # HTTP-сервисы расширений в публикации
# Учётка ИБ для Basic (только UTF-8); фолбэк — WEB_TEST_USER/WEB_TEST_PASSWORD
# IBSRV_USER=""
# IBSRV_PASSWORD=""

# UpdateDB упёрся в конфликт сеансов (вторую публикацию ИБ держит другая служба
# Apache — HTTP-клиенты — либо база удерживается активными сеансами/исключительной
# блокировкой):
# true (по умолчанию) — повторить /UpdateDBCfg с -Dynamic- -SessionTerminate force
# (принудительно завершить сеансы; пользователи отключаются, в лог идёт WARN).
# false — не завершать сеансы: скрипт упадёт с подсказкой. На prod включайте осознанно.
# Пусто = не задано: на базе автономного сервера (IBSRV_PID_FILE) — false.
# UPDATE_DB_FORCE_SESSIONS="true"
